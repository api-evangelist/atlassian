      "item": [
        {
          "id": "4c4631ff-d745-47e2-951c-26425de54b04",
          "name": "Atlassian List Open Branches",
          "request": {
            "name": "Atlassian List Open Branches",
            "description": {
              "content": "This API operation retrieves a paginated list of all branches in a specified Bitbucket repository by providing the workspace identifier and repository slug in the path parameters. It returns comprehensive branch information including branch names, associated commit details, target information, and metadata about each branch's state. The response follows Bitbucket's standard pagination format, making it suitable for repositories with numerous branches, and is commonly used for displaying available branches, implementing branch selection interfaces, or auditing repository branch structure.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "repositories",
                ":workspace",
                ":repo_slug",
                "refs",
                "branches"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "\nQuery string to narrow down the response as per\n[filtering and sorting](/cloud/bitbucket/rest/intro/#filtering)."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "\nField by which the results should be sorted as per\n[filtering and sorting](/cloud/bitbucket/rest/intro/#filtering). The `name`\nfield is handled specially for branches in that, if specified as the sort field, it\nuses a natural sort order instead of the default lexicographical sort order. For example,\nit will return ['branch1', 'branch2', 'branch10'] instead of ['branch1', 'branch10', 'branch2']."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repo_slug",
                  "description": "(Required) This can either be the repository slug or the UUID of the repository,\nsurrounded by curly-braces, for example: `{repository UUID}`.\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspace",
                  "description": "(Required) This can either be the workspace ID (slug) or the workspace UUID\nsurrounded by curly-braces, for example: `{workspace UUID}`.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "read:org:admin write:org:admin read:user:admin write:user:admin read:policy:admin write:policy:admin read:event:admin"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://auth.atlassian.com/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://auth.atlassian.com/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
