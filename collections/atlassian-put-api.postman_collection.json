          "id": "f41c853c-02aa-441b-9c93-9dc9c3a6208b",
          "name": "Atlassian Put Addon Linkers Key Values",
          "request": {
            "name": "Atlassian Put Addon Linkers Key Values",
            "description": {
              "content": "Bulk update [linker](/cloud/bitbucket/modules/linker/) values for the specified\nlinker of the authenticated application.\n\nA linker value lets applications supply values to modify its regular expression.\n\nThe base regular expression must use a Bitbucket-specific match group `(?K)`\nwhich will be translated to `([\\w\\-]+)`. A value must match this pattern.\n\n[Read more about linker values](/cloud/bitbucket/modules/linker/#usingthebitbucketapitosupplyvalues)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "addon",
                "linkers",
                ":linker_key",
                "values"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "linker_key",
                  "description": "(Required) The unique key of a [linker module](/cloud/bitbucket/modules/linker/)\nas defined in an application descriptor."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "read:org:admin write:org:admin read:user:admin write:user:admin read:policy:admin write:policy:admin read:event:admin"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://auth.atlassian.com/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://auth.atlassian.com/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
