{
  "opencollection": "1.0.0",
  "info": {
    "name": "Atlassian Admin Account Announcement Banner API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Announcement Banner",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Atlassian Get Announcement Banner Configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.atlassian.com/rest/api/3/announcementBanner"
          },
          "docs": "Returns the current announcement banner configuration.<br><br>**[Permissions](#permissions) required:** *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg)."
        },
        {
          "info": {
            "name": "Atlassian Update Announcement Banner Configuration",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.atlassian.com/rest/api/3/announcementBanner",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the announcement banner configuration.<br><br>**[Permissions](#permissions) required:** *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg)."
        }
      ]
    }
  ],
  "bundled": true
}