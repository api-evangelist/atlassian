        {
          "id": "af24c0a3-1ea9-4c40-9b98-fae8a7ec4e28",
          "name": "Atlassian Update Pull Request Application Property",
          "request": {
            "name": "Atlassian Update Pull Request Application Property",
            "description": {
              "content": "This API operation allows you to update or set an application-specific property on a Bitbucket pull request within a repository. By making a PUT request to the endpoint with the workspace identifier, repository slug, pull request ID, application key, and property name, you can store custom metadata or configuration data associated with that specific pull request. This is particularly useful for third-party applications or integrations that need to maintain their own state or settings related to a pull request, such as storing build statuses, review preferences, or custom workflow information. The operation requires appropriate authentication and permissions to modify properties on the specified pull request, and it will either create a new property if it doesn't exist or update the existing value if the property is already present.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "repositories",
                ":workspace",
                ":repo_slug",
                "pullrequests",
                ":pullrequest_id",
                "properties",
                ":app_key",
                ":property_name"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspace",
                  "description": "(Required) The repository container; either the workspace slug or the UUID in curly braces."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repo_slug",
                  "description": "(Required) The repository."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "pullrequest_id",
                  "description": "(Required) The pull request ID."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "app_key",
                  "description": "(Required) The key of the Connect app."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "property_name",
                  "description": "(Required) The name of the property."
                }
              ]
            },
