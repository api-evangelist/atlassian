          "id": "dcaaa9cf-aaf8-416c-86c0-c4328a37bb67",
          "name": "Atlassian Export Audit Records",
          "request": {
            "name": "Atlassian Export Audit Records",
            "description": {
              "content": "The Export Audit Records operation is a GET endpoint in the Atlassian Confluence Audit API accessible via `/wiki/rest/api/audit/export` that allows administrators to retrieve and download audit log data from their Confluence instance. This endpoint enables users to export audit records in a structured format for compliance, security analysis, archival purposes, or integration with external monitoring and SIEM systems. The operation typically supports filtering parameters to narrow down the audit records by date range, event type, user, or affected content, and returns the data in a downloadable format such as CSV or JSON. This functionality is essential for organizations that need to maintain comprehensive audit trails of user activities, content changes, permission modifications, and system events within their Confluence workspace for regulatory compliance and security auditing requirements.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wiki",
                "rest",
                "api",
                "audit",
                "export"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<string>",
                  "description": "Filters the exported results to the records on or after the `startDate`.\nThe `startDate` must be specified as [epoch time](https://www.epochconverter.com/) in milliseconds."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<string>",
                  "description": "Filters the exported results to the records on or before the `endDate`.\nThe `endDate` must be specified as [epoch time](https://www.epochconverter.com/) in milliseconds."
                },
                {
                  "disabled": false,
                  "key": "searchString",
                  "value": "<string>",
                  "description": "Filters the exported results to records that have string property values\nmatching the `searchString`."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "csv",
                  "description": "The format of the export file for the audit records."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/zip"
              }
            ],
            "method": "GET"
          },
