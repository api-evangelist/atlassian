{
  "opencollection": "1.0.0",
  "info": {
    "name": "Atlassian Admin Account Classification Levels API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Classification Levels",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Atlassian Get All Classification Levels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.atlassian.com/rest/api/3/classification-levels",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Optional set of statuses to filter by."
              },
              {
                "name": "orderBy",
                "value": "",
                "type": "query",
                "description": "Ordering of the results by a given field. If not provided, values will not be sorted."
              }
            ]
          },
          "docs": "Returns all classification levels.<br><br>**[Permissions](#permissions) required:** None."
        }
      ]
    }
  ],
  "bundled": true
}