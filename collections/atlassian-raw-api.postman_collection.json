        {
          "id": "853f13ae-6edf-4bcc-b276-17552cc75bf1",
          "name": "Atlassian Get Snippets Raw File",
          "request": {
            "name": "Atlassian Get Snippets Raw File",
            "description": {
              "content": "This API operation retrieves the raw content of a specific file within a particular revision of a Bitbucket snippet. By providing the workspace identifier, the encoded snippet ID, a specific node ID (representing a commit or revision), and the file path, you can access the unprocessed file content directly. This is particularly useful when you need to programmatically fetch the exact contents of a snippet file at a specific point in its version history, whether for display purposes, downloading, or further processing in your application.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "snippets",
                ":workspace",
                ":encoded_id",
                ":node_id",
                "files",
                ":path"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "encoded_id",
                  "description": "(Required) The snippet id."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "node_id",
                  "description": "(Required) A commit revision (SHA1)."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "path",
                  "description": "(Required) Path to the file."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspace",
                  "description": "(Required) This can either be the workspace ID (slug) or the workspace UUID\nsurrounded by curly-braces, for example: `{workspace UUID}`.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
