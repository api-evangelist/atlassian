{
  "opencollection": "1.0.0",
  "info": {
    "name": "Atlassian Admin Account App Data Policies (EAP) API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "App Data Policies (EAP)",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Atlassian Get Data Policy For Projects Eap",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.atlassian.com/rest/api/3/data-policy/project",
            "params": [
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "A list of project identifiers. This parameter accepts a comma-separated list."
              }
            ]
          },
          "docs": "Returns data policies for the projects specified in the request."
        },
        {
          "info": {
            "name": "Atlassian Get Data Policy For The Workspace Eap",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.atlassian.com/rest/api/3/data-policy"
          },
          "docs": "Returns data policy for the workspace."
        }
      ]
    }
  ],
  "bundled": true
}