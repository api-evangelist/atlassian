        {
          "id": "4fe0640f-9c57-4058-8e22-2ed5569e24eb",
          "name": "Atlassian Set Comment Property",
          "request": {
            "name": "Atlassian Set Comment Property",
            "description": {
              "content": "Creates or updates the value of a property for a comment. Use this resource to store custom data against a comment.<br><br>The value of the request body must be a [valid](http://tools.ietf.org/html/rfc4627), non-empty JSON blob. The maximum length is 32768 characters.<br><br>**[Permissions](#permissions) required:** either of:<br><br> *  *Edit All Comments* [project permission](https://confluence.atlassian.com/x/yodKLg) to create or update the value of a property on any comment.<br> *  *Edit Own Comments* [project permission](https://confluence.atlassian.com/x/yodKLg) to create or update the value of a property on a comment created by the user.<br><br>Also, when the visibility of a comment is restricted to a role or group the user must be a member of that role or group.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "api",
                "3",
                "comment",
                ":commentId",
                "properties",
                ":propertyKey"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "commentId",
                  "description": "(Required) The ID of the comment."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "propertyKey",
                  "description": "(Required) The key of the property. The maximum length is 255 characters."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
