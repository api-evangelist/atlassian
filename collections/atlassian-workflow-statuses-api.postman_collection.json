          "id": "ae301ec8-f610-416e-89ce-6efbf2b03187",
          "name": "Atlassian Get Status",
          "request": {
            "name": "Atlassian Get Status",
            "description": {
              "content": "Returns a status. The status must be associated with an active workflow to be returned.<br><br>If a name is used on more than one status, only the status found first is returned. Therefore, identifying the status by its ID may be preferable.<br><br>This operation can be accessed anonymously.<br><br>[Permissions](#permissions) required: None.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "api",
                "3",
                "status",
                ":idOrName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "idOrName",
                  "description": "(Required) The ID or name of the status."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
