      "item": [
        {
          "id": "8192f48e-c5aa-45ee-8ebc-f255d61660de",
          "name": "Atlassian Unapprove Pull Request",
          "request": {
            "name": "Atlassian Unapprove Pull Request",
            "description": {
              "content": "The Atlassian Bitbucket Pull Requests API DELETE endpoint at /repositories/{workspace}/{repo_slug}/pullrequests/{pull_request_id}/approve allows authenticated users to remove their approval from a previously approved pull request. This operation requires the workspace name, repository slug, and pull request ID as path parameters to identify the specific pull request from which the approval should be withdrawn. When executed, it revokes the caller's approval status on the designated pull request, effectively removing their vote of confidence in merging the proposed changes. This is useful when a reviewer changes their mind after reviewing new commits, discovering issues, or when their initial approval was given in error. The endpoint returns a success response when the approval is successfully removed, and appropriate error codes if the pull request doesn't exist, the user hasn't previously approved it, or authentication fails.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "repositories",
                ":workspace",
                ":repo_slug",
                "pullrequests",
                ":pull_request_id",
                "approve"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "pull_request_id",
                  "description": "(Required) The id of the pull request."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repo_slug",
                  "description": "(Required) This can either be the repository slug or the UUID of the repository,\nsurrounded by curly-braces, for example: `{repository UUID}`.\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspace",
                  "description": "(Required) This can either be the workspace ID (slug) or the workspace UUID\nsurrounded by curly-braces, for example: `{workspace UUID}`.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "read:org:admin write:org:admin read:user:admin write:user:admin read:policy:admin write:policy:admin read:event:admin"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://auth.atlassian.com/oauth/token"
