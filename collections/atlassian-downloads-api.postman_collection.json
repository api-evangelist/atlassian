          "request": {
            "name": "Atlassian Get A Download Artifact Link",
            "description": {
              "content": "Return a redirect to the contents of a download artifact.<br><br>This endpoint returns the actual file contents and not the artifact's<br>metadata.<br><br>    $ curl -s -L https://api.bitbucket.org/2.0/repositories/evzijst/git-tests/downloads/hello.txt<br>    Hello World",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "repositories",
                ":workspace",
                ":repo_slug",
                "downloads",
