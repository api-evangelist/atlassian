        {
          "id": "ca35c22e-5148-4026-a188-070a7e9f0345",
          "name": "Atlassian Get Audit Records for Time Period",
          "request": {
            "name": "Atlassian Get Audit Records for Time Period",
            "description": {
              "content": "The Atlassian Confluence Audit API endpoint `/wiki/rest/api/audit/since` using the GET method retrieves audit records that have been created since a specified time period. This operation allows administrators and authorized users to query and review system audit logs within a defined timeframe, providing visibility into user actions, system changes, and security-related events that occurred after a particular timestamp. The endpoint is essential for compliance monitoring, security auditing, and tracking changes made to Confluence spaces, pages, and configuration settings over time.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wiki",
                "rest",
                "api",
                "audit",
                "since"
