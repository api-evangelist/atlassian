        {
          "id": "e530651f-97da-44d8-8db1-8cdca304130f",
          "name": "Atlassian Remove Label From Content",
          "request": {
            "name": "Atlassian Remove Label From Content",
            "description": {
              "content": "Removes a specific label from a Confluence content item identified by its content ID. This DELETE operation targets the endpoint /wiki/rest/api/content/{id}/label/{label} where {id} represents the unique identifier of the content (such as a page or blog post) and {label} is the name of the label to be removed. When executed successfully, the API removes the association between the specified label and the content, effectively unlabeling that content item. This operation is useful for content management workflows where labels are used for categorization, organization, or search purposes and need to be dynamically updated or removed. The operation requires appropriate permissions to modify labels on the target content and returns a success response when the label is successfully removed from the content item.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wiki",
                "rest",
                "api",
                "content",
                ":id",
                "label",
                ":label"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The ID of the content that the label will be removed from."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "label",
                  "description": "(Required) The name of the label to be removed."
