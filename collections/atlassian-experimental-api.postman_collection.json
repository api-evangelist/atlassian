        {
          "id": "4a99d372-46b3-4498-9219-b98bde1387e3",
          "name": "Atlassian Add Labels to a Space",
          "request": {
            "name": "Atlassian Add Labels to a Space",
            "description": {
              "content": "Adds labels to a piece of content. Does not modify the existing labels.<br><br>Notes:<br><br>- Labels can also be added when creating content ([Create content](#api-content-post)).<br>- Labels can be updated when updating content ([Update content](#api-content-id-put)).<br>This will delete the existing labels and replace them with the labels in<br>the request.<br><br>**[Permissions](https://confluence.atlassian.com/x/_AozKw) required**:<br>Permission to update the content.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wiki",
                "rest",
                "api",
                "space",
                ":spaceKey",
                "label"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "spaceKey",
                  "description": "(Required) The key of the space to add labels to."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"name\": \"<string>\",\n    \"prefix\": \"<string>\"\n  },\n  {\n    \"name\": \"<string>\",\n    \"prefix\": \"<string>\"\n  }\n]",
