        {
          "id": "2403a958-7951-4f6c-9f6c-da3d1e6fdff7",
          "name": "Atlassian Get Valid Project Name",
          "request": {
            "name": "Atlassian Get Valid Project Name",
            "description": {
              "content": "Checks that a project name isn't in use. If the name isn't in use, the passed string is returned. If the name is in use, this operation attempts to generate a valid project name based on the one supplied, usually by adding a sequence number. If a valid project name cannot be generated, a 404 response is returned.<br><br>**[Permissions](#permissions) required:** None.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "api",
                "3",
                "projectvalidate",
                "validProjectName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "(Required) The project name."
