        {
          "id": "017f8e29-1d49-4d8c-bef5-b96f8714fe58",
          "name": "Atlassian Get Variable for Team",
          "request": {
            "name": "Atlassian Get Variable for Team",
            "description": {
              "content": "This API operation retrieves detailed information about a specific pipeline variable configured at the team level in Bitbucket. By providing the Teams username and the unique identifier (UUID) of the variable, you can fetch the variable's configuration details including its name, value, security settings, and other metadata. This is particularly useful when you need to inspect or validate existing pipeline variables that are shared across all repositories within a team, allowing administrators to manage and audit environment variables, credentials, or other configuration values used during the CI/CD pipeline execution process.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "teams",
                ":username",
                "pipelines_config",
                "variables",
                ":variable_uuid"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "username",
                  "description": "(Required) The account."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "variable_uuid",
                  "description": "(Required) The UUID of the variable to retrieve."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
