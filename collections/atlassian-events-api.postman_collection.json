          "id": "0a9c0487-a3fd-4dd9-bdc5-ec4f2fb97786",
          "name": "Atlassian Get Organization Events",
          "request": {
            "name": "Atlassian Get Organization Events",
            "description": {
              "content": "Returns a paginated list of events for the organization. Events represent audit trail entries for actions performed within the organization, such as user changes, policy updates, and access modifications.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "orgs",
                ":orgId",
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Cursor for paginated results."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<dateTime>",
                  "description": "Filter events from this date-time (ISO 8601 format). Returns events that occurred on or after this time."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<dateTime>",
                  "description": "Filter events up to this date-time (ISO 8601 format). Returns events that occurred on or before this time."
                },
                {
                  "disabled": false,
                  "key": "action",
                  "value": "<string>",
                  "description": "Filter events by action type."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "orgId",
                  "description": "(Required) The unique identifier of the organization."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
