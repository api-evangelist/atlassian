          "id": "07f5c6bd-40f6-4b86-9655-af8d2355d47b",
          "name": "Atlassian Archive Pages",
          "request": {
            "name": "Atlassian Archive Pages",
            "description": {
              "content": "Archives one or more pages in Confluence, which removes them from normal view and search results while preserving the content for potential future restoration. This operation requires appropriate permissions and accepts a list of page IDs to be archived simultaneously. When pages are archived, they become inaccessible to most users but can be managed by administrators through the archive interface. The operation helps maintain workspace organization by allowing teams to hide outdated or irrelevant content without permanently deleting it, supporting content lifecycle management and compliance requirements while maintaining the ability to recover information if needed.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wiki",
                "rest",
                "api",
                "content",
                "archive"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pages\": [\n    {\n      \"id\": \"<long>\"\n    },\n    {\n      \"id\": \"<long>\"\n    }\n  ]\n}",
