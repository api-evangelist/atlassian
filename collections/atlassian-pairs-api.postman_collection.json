        {
          "id": "d42095ed-ffe0-4485-983e-89d065ebbb5f",
          "name": "Atlassian Delete Ssh Key Pair",
          "request": {
            "name": "Atlassian Delete Ssh Key Pair",
            "description": {
              "content": "This API operation deletes the configured SSH key pair associated with a specific Bitbucket Pipelines configuration for a repository. By sending a DELETE request to this endpoint with the workspace identifier and repository slug, administrators can remove the SSH key pair that was previously set up for secure authentication during pipeline executions. This is typically used when rotating credentials, revoking access, or when the key pair is no longer needed for the repository's CI/CD pipeline operations. Once deleted, pipelines that relied on this SSH key pair for authentication to external services or remote servers will no longer have access until a new key pair is configured.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "repositories",
                ":workspace",
                ":repo_slug",
                "pipelines_config",
                "ssh",
                "key_pair"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
