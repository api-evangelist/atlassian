      "item": [
        {
          "id": "f97ebf89-e629-4195-b505-4bf4a7a4f428",
          "name": "Atlassian Get Custom Field Configurations",
          "request": {
            "name": "Atlassian Get Custom Field Configurations",
            "description": {
              "content": "Returns a [paginated](#pagination) list of configurations for a custom field of a [type](https://developer.atlassian.com/platform/forge/manifest-reference/modules/jira-custom-field-type/) created by a [Forge app](https://developer.atlassian.com/platform/forge/).<br><br>The result can be filtered by one of these criteria:<br><br> *  `id`.<br> *  `fieldContextId`.<br> *  `issueId`.<br> *  `projectKeyOrId` and `issueTypeId`.<br><br>Otherwise, all configurations are returned.<br><br>**[Permissions](#permissions) required:** *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg). Jira permissions are not required for the Forge app that provided the custom field type.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "api",
                "3",
                "app",
                "field",
                ":fieldIdOrKey",
                "context",
                "configuration"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<long>",
                  "description": "The list of configuration IDs. To include multiple configurations, separate IDs with an ampersand: `id=10000&id=10001`. Can't be provided with `fieldContextId`, `issueId`, `projectKeyOrId`, or `issueTypeId`."
                },
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<long>",
                  "description": "The list of configuration IDs. To include multiple configurations, separate IDs with an ampersand: `id=10000&id=10001`. Can't be provided with `fieldContextId`, `issueId`, `projectKeyOrId`, or `issueTypeId`."
                },
                {
                  "disabled": false,
                  "key": "fieldContextId",
                  "value": "<long>",
                  "description": "The list of field context IDs. To include multiple field contexts, separate IDs with an ampersand: `fieldContextId=10000&fieldContextId=10001`. Can't be provided with `id`, `issueId`, `projectKeyOrId`, or `issueTypeId`."
                },
                {
                  "disabled": false,
                  "key": "fieldContextId",
                  "value": "<long>",
                  "description": "The list of field context IDs. To include multiple field contexts, separate IDs with an ampersand: `fieldContextId=10000&fieldContextId=10001`. Can't be provided with `id`, `issueId`, `projectKeyOrId`, or `issueTypeId`."
                },
                {
                  "disabled": false,
                  "key": "issueId",
                  "value": "<long>",
                  "description": "The ID of the issue to filter results by. If the issue doesn't exist, an empty list is returned. Can't be provided with `projectKeyOrId`, or `issueTypeId`."
                },
                {
                  "disabled": false,
                  "key": "projectKeyOrId",
                  "value": "<string>",
                  "description": "The ID or key of the project to filter results by. Must be provided with `issueTypeId`. Can't be provided with `issueId`."
                },
                {
                  "disabled": false,
                  "key": "issueTypeId",
                  "value": "<string>",
                  "description": "The ID of the issue type to filter results by. Must be provided with `projectKeyOrId`. Can't be provided with `issueId`."
                },
                {
                  "disabled": false,
                  "key": "startAt",
                  "value": "0",
                  "description": "The index of the first item to return in a page of results (page offset)."
                },
                {
                  "disabled": false,
                  "key": "maxResults",
                  "value": "100",
                  "description": "The maximum number of items to return per page."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "fieldIdOrKey",
                  "description": "(Required) The ID or key of the custom field, for example `customfield_10000`."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
          "response": [
            {
              "id": "e564b636-a911-46f6-bfde-cd1190a7759c",
              "name": "Returned if the request is successful.",
              "originalRequest": {
