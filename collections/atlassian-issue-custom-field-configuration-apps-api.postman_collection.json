        {
          "id": "840dcaee-ac45-45c3-ba9b-ac0e47619851",
          "name": "Atlassian Update Custom Field Configurations",
          "request": {
            "name": "Atlassian Update Custom Field Configurations",
            "description": {
              "content": "Update the configuration for contexts of a custom field of a [type](https://developer.atlassian.com/platform/forge/manifest-reference/modules/jira-custom-field-type/) created by a [Forge app](https://developer.atlassian.com/platform/forge/).<br><br>**[Permissions](#permissions) required:** *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg). Jira permissions are not required for the Forge app that created the custom field type.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "api",
                "3",
                "app",
                "field",
                ":fieldIdOrKey",
                "context",
                "configuration"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "fieldIdOrKey",
                  "description": "(Required) The ID or key of the custom field, for example `customfield_10000`."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"configurations\": [\n    {\n      \"id\": \"<string>\",\n      \"configuration\": {},\n      \"schema\": {}\n    }\n  ]\n}",
