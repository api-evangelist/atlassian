        {
          "id": "ca19a7be-d309-4167-a9aa-f125c683ef04",
          "name": "Atlassian Remove Label From Content",
          "request": {
            "name": "Atlassian Remove Label From Content",
            "description": {
              "content": "Removes a label from a piece of content. Labels can't be deleted from archived content.<br>This is similar to [Remove label from content using query parameter](#api-content-id-label-delete)<br>except that the label name is specified via a path parameter.<br><br>Use this method if the label name does not have \"/\" characters, as the path<br>parameter does not accept \"/\" characters for security reasons. Otherwise,<br>use [Remove label from content using query parameter](#api-content-id-label-delete).<br><br>**[Permissions](https://confluence.atlassian.com/x/_AozKw) required**:<br>Permission to update the content.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wiki",
                "rest",
                "api",
                "content",
                ":id",
                "label",
                ":label"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The ID of the content that the label will be removed from."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "label",
                  "description": "(Required) The name of the label to be removed."
                }
              ]
            },
            "method": "DELETE"
          },
          "response": [
            {
              "id": "e0f13cdb-a5d1-4676-b74e-643c573b3f50",
              "name": "Returned if the label is removed. The response body will be empty.",
