        {
          "id": "313b0355-5ac9-488f-995f-3a7d766dee22",
          "name": "Atlassian Check Issue Export Status",
          "request": {
            "name": "Atlassian Check Issue Export Status",
            "description": {
              "content": "This GET operation checks the status of a previously initiated issue export request for a specific Bitbucket repository by polling the export endpoint using the provided task ID. When called, it queries the export job identified by the workspace, repository slug, repository name, and unique task identifier to determine whether the export process is still running, has completed successfully, or has failed. If the export is complete, the endpoint returns the ZIP file containing the exported issues data; otherwise, it provides status information about the ongoing export process. This allows users to monitor long-running export operations and retrieve the results once processing is finished without blocking or timing out during the initial export request.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "repositories",
                ":workspace",
                ":repo_slug",
                "issues",
                "export",
                "{{repo_name}}-issues-{{task_id}}.zip"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repo_slug",
                  "description": "(Required) This can either be the repository slug or the UUID of the repository,\nsurrounded by curly-braces, for example: `{repository UUID}`.\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspace",
                  "description": "(Required) This can either be the workspace ID (slug) or the workspace UUID\nsurrounded by curly-braces, for example: `{workspace UUID}`.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
