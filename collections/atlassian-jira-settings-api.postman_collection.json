          "id": "769378d3-00b0-495d-8f92-b1f26bbd80b7",
          "name": "Atlassian Get Advanced Settings",
          "request": {
            "name": "Atlassian Get Advanced Settings",
            "description": {
              "content": "Returns the application properties that are accessible on the *Advanced Settings* page. To navigate to the *Advanced Settings* page in Jira, choose the Jira icon > **Jira settings** > **System**, **General Configuration** and then click **Advanced Settings** (in the upper right).<br><br>**[Permissions](#permissions) required:** *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "api",
                "3",
                "application-properties",
                "advanced-settings"
