        {
          "id": "e3a1cdbe-c14b-4e72-a8e4-e046290eb87b",
          "name": "Atlassian Upload Download Artifact",
          "request": {
            "name": "Atlassian Upload Download Artifact",
            "description": {
              "content": "This API operation allows you to upload a download artifact to a specific Bitbucket repository within a workspace. By sending a POST request to the endpoint with the workspace ID and repository slug as path parameters, you can attach files that will be made available as downloads for the repository. These artifacts are typically binary files, releases, or other distributable assets that you want to make accessible to users who have access to the repository. The uploaded files are stored separately from the repository's version control system and can be downloaded directly through Bitbucket's download interface, making this useful for sharing compiled binaries, documentation packages, or other supplementary materials related to your project.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "repositories",
                ":workspace",
                ":repo_slug",
                "downloads"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
