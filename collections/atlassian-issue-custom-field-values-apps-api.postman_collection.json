                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"updates\": [\n    {\n      \"customField\": \"customfield_10010\",\n      \"issueIds\": [\n        10010,\n        10011\n      ],\n      \"value\": \"new value\"\n    },\n    {\n      \"customField\": \"customfield_10011\",\n      \"issueIds\": [\n        10010\n      ],\n      \"value\": 1000\n    }\n  ]\n}",
