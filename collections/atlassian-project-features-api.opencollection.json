{
  "opencollection": "1.0.0",
  "info": {
    "name": "Atlassian Admin Account Project Features API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Project Features",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Atlassian Get Project Features",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.atlassian.com/rest/api/3/project/:projectIdOrKey/features",
            "params": [
              {
                "name": "projectIdOrKey",
                "value": "",
                "type": "path",
                "description": "The ID or (case-sensitive) key of the project."
              }
            ]
          },
          "docs": "Returns the list of features for a project."
        },
        {
          "info": {
            "name": "Atlassian Set Project Feature State",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.atlassian.com/rest/api/3/project/:projectIdOrKey/features/:featureKey",
            "params": [
              {
                "name": "projectIdOrKey",
                "value": "",
                "type": "path",
                "description": "The ID or (case-sensitive) key of the project."
              },
              {
                "name": "featureKey",
                "value": "",
                "type": "path",
                "description": "The key of the feature."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sets the state of a project feature."
        }
      ]
    }
  ],
  "bundled": true
}