{
  "opencollection": "1.0.0",
  "info": {
    "name": "Atlassian Admin Account Project Categories API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Project Categories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Atlassian Get Project Category By Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.atlassian.com/rest/api/3/projectCategory/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the project category."
              }
            ]
          },
          "docs": "Returns a project category.<br><br>**[Permissions](#permissions) required:** Permission to access Jira."
        },
        {
          "info": {
            "name": "Atlassian Update Project Category",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.atlassian.com/rest/api/3/projectCategory/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a project category.<br><br>**[Permissions](#permissions) required:** *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg)."
        },
        {
          "info": {
            "name": "Atlassian Delete Project Category",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.atlassian.com/rest/api/3/projectCategory/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the project category to delete."
              }
            ]
          },
          "docs": "Deletes a project category.<br><br>**[Permissions](#permissions) required:** *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg)."
        },
        {
          "info": {
            "name": "Atlassian Get All Project Categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.atlassian.com/rest/api/3/projectCategory"
          },
          "docs": "Returns all project categories.<br><br>**[Permissions](#permissions) required:** Permission to access Jira."
        },
        {
          "info": {
            "name": "Atlassian Create Project Category",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.atlassian.com/rest/api/3/projectCategory",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a project category.<br><br>**[Permissions](#permissions) required:** *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg)."
