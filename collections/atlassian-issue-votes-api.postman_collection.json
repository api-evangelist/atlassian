        {
          "id": "eb1de1d9-d83c-4385-b4cf-7cad319ef88c",
          "name": "Atlassian Delete Vote",
          "request": {
            "name": "Atlassian Delete Vote",
            "description": {
              "content": "Deletes a user's vote from an issue. This is the equivalent of the user clicking *Unvote* on an issue in Jira.<br><br>This operation requires the **Allow users to vote on issues** option to be *ON*. This option is set in General configuration for Jira. See [Configuring Jira application options](https://confluence.atlassian.com/x/uYXKM) for details.<br><br>**[Permissions](#permissions) required:**<br><br> *  *Browse projects* [project permission](https://confluence.atlassian.com/x/yodKLg) for the project that the issue is in.<br> *  If [issue-level security](https://confluence.atlassian.com/x/J4lKLg) is configured, issue-level security permission to view the issue.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "api",
                "3",
                "issue",
                ":issueIdOrKey",
                "votes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "issueIdOrKey",
                  "description": "(Required) The ID or key of the issue."
                }
              ]
            },
            "method": "DELETE",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [
