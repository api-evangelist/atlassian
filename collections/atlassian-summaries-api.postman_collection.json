          "id": "6b338052-419a-4f67-b0eb-4531a428682b",
          "name": "Atlassian Get Summary of Test Reports for Given Step of Pipeline.",
          "request": {
            "name": "Atlassian Get Summary of Test Reports for Given Step of Pipeline.",
            "description": {
              "content": "This API endpoint retrieves a comprehensive summary of test reports for a specific step within a pipeline execution in a Bitbucket repository. By providing the workspace identifier, repository slug, pipeline UUID, and step UUID as path parameters, users can access aggregated test results including passed, failed, and skipped tests, along with detailed metrics and statistics generated during that particular pipeline step's test execution phase.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "repositories",
                ":workspace",
                ":repo_slug",
                "pipelines",
                ":pipeline_uuid",
                "steps",
                ":step_uuid",
                "test_reports"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspace",
                  "description": "(Required) This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repo_slug",
                  "description": "(Required) The repository."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "pipeline_uuid",
                  "description": "(Required) The UUID of the pipeline."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "step_uuid",
                  "description": "(Required) The UUID of the step."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "read:org:admin write:org:admin read:user:admin write:user:admin read:policy:admin write:policy:admin read:event:admin"
                },
