        {
          "id": "b2df89fd-c0a1-4ea9-917f-a2ac4030584c",
          "name": "Atlassian Assign Workflow Scheme To Project",
          "request": {
            "name": "Atlassian Assign Workflow Scheme To Project",
            "description": {
              "content": "Assigns a workflow scheme to a project. This operation is performed only when there are no issues in the project.<br><br>Workflow schemes can only be assigned to classic projects.<br><br>**[Permissions](#permissions) required:** *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "api",
                "3",
                "workflowscheme",
                "project"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"<string>\",\n  \"workflowSchemeId\": \"<string>\"\n}",
              "options": {
                "raw": {
