          "id": "d6bbe078-863d-4ddc-af56-8e6af97b2940",
          "name": "Atlassian Search for Code in Teams Repositories",
          "request": {
            "name": "Atlassian Search for Code in Teams Repositories",
            "description": {
              "content": "This API operation allows you to search for code across all repositories belonging to a specific team in Bitbucket. By making a GET request to the endpoint with the team's username as a path parameter, you can perform code searches within the team's repository collection. The operation returns matching code snippets and their locations across the team's codebase, making it useful for finding specific code patterns, function definitions, or text strings across multiple repositories owned by the team. This is particularly valuable for organizations that need to audit code, find usage examples, or track specific implementations across their team's projects.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "teams",
                ":username",
                "search",
                "code"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "search_query",
                  "value": "<string>",
                  "description": "(Required) The search query"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Which page of the search results to retrieve"
                },
                {
                  "disabled": false,
                  "key": "pagelen",
                  "value": "10",
                  "description": "How many search results to retrieve per page"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "username",
                  "description": "(Required) The account to search in; either the username or the UUID in curly braces"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "read:org:admin write:org:admin read:user:admin write:user:admin read:policy:admin write:policy:admin read:event:admin"
