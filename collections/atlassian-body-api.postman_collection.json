      "item": [
        {
          "id": "c097b841-2719-4ac5-8191-757d415439a6",
          "name": "Atlassian Get Macro Body by Macro Id",
          "request": {
            "name": "Atlassian Get Macro Body by Macro Id",
            "description": {
              "content": "Retrieves the body content of a specific macro identified by its macro ID within a particular version of a Confluence page. This endpoint requires three path parameters: the content ID of the page, the version number of that content, and the unique macro ID whose body you want to retrieve. It's particularly useful when you need to extract or inspect the content of a specific macro instance that existed in a historical version of a page, allowing developers to access macro parameters, content, or configuration from past revisions without having to parse the entire page markup.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wiki",
                "rest",
                "api",
                "content",
                ":id",
                "history",
                ":version",
                "macro",
                "id",
                ":macroId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The ID for the content that contains the macro."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "version",
                  "description": "(Required) The version of the content that contains the macro. Specifying `0` as the `version` will return\nthe macro body for the latest content version."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "macroId",
                  "description": "(Required) The ID of the macro. This is usually passed by the app that the\nmacro is in. Otherwise, find the macro ID by querying the desired\ncontent and version, then expanding the body in storage format.\nFor example, '/content/196611/version/7?expand=content.body.storage'."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
          "response": [
            {
              "id": "e9c6b9d3-7517-4bae-9ac7-2269df41543e",
              "name": "Returned if the requested macro body is returned.",
