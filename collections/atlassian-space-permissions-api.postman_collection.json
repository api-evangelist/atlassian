          "id": "af283832-8b84-414d-b514-b24c29ce50c6",
          "name": "Atlassian Add New Permission to Space",
          "request": {
            "name": "Atlassian Add New Permission to Space",
            "description": {
              "content": "Adds new permission to space.<br><br>If the permission to be added is a group permission, the group can be identified<br>by its group name or group id.<br><br>Note: Apps cannot access this REST resource - including when utilizing user impersonation.<br><br>**[Permissions](https://confluence.atlassian.com/x/_AozKw) required**:<br>'Admin' permission for the space.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wiki",
                "rest",
                "api",
                "space",
                ":spaceKey",
                "permission"
              ],
              "host": [
                "{{baseUrl}}"
