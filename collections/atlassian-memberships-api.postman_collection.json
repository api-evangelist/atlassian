        {
          "id": "b382d950-905b-4ac1-8dae-11aefee26259",
          "name": "Atlassian Get User Membership for a Workspace",
          "request": {
            "name": "Atlassian Get User Membership for a Workspace",
            "description": {
              "content": "This GET operation retrieves detailed information about a specific user's membership within a designated Bitbucket workspace. By providing the workspace identifier and member identifier in the URL path parameters, the API returns the membership details for that particular user, including their role, permissions, and associated account information within the context of the specified workspace. This endpoint is useful for administrators and applications that need to verify a user's access level, check membership status, or retrieve specific member details for workspace management purposes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "workspaces",
                ":workspace",
                "members",
                ":member"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "member",
                  "description": "(Required) Member's UUID or Atlassian ID."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspace",
                  "description": "(Required) This can either be the workspace ID (slug) or the workspace UUID\nsurrounded by curly-braces, for example: `{workspace UUID}`.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "read:org:admin write:org:admin read:user:admin write:user:admin read:policy:admin write:policy:admin read:event:admin"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://auth.atlassian.com/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://auth.atlassian.com/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
          "response": [
