        {
          "id": "1f25bb06-ca01-4377-83b5-bb831e94a0e3",
          "name": "Atlassian Remove Label From Content Using Query Parameter",
          "request": {
            "name": "Atlassian Remove Label From Content Using Query Parameter",
            "description": {
              "content": "This API operation removes a label from a specific piece of Confluence content by specifying the content ID in the URL path and the label name as a query parameter. When executed with a DELETE HTTP method, it allows users to untag or dissociate a previously applied label from a page, blog post, or other content item in Confluence. The operation requires appropriate permissions to modify labels on the target content and will return a success response once the label has been successfully removed from the specified content item.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wiki",
                "rest",
                "api",
                "content",
                ":id",
                "label"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "(Required) The name of the label to be removed."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The ID of the content that the label will be removed from."
                }
              ]
            },
            "method": "DELETE"
          },
          "response": [
            {
              "id": "d9629261-7ce4-428f-a93c-5ee7212fe8c9",
              "name": "Returned if the label is removed. The response body will be empty.",
