                  "value": "application/json"
                }
              ],
              "body": "{\n  \"size\": 42,\n  \"page\": 1,\n  \"pagelen\": 10,\n  \"next\": \"https://api.example.com/repositories/myrepo/commits/abc123/tree?page=2\",\n  \"previous\": \"https://api.example.com/repositories/myrepo/commits/abc123/tree?page=0\",\n  \"values\": []\n}",
